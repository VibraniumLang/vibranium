<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15.0</LangVersion>
    <AssemblyName>vib-mutation</AssemblyName>
    <RootNamespace>Vibranium.Mutation</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <ProjectReference Include="../../src/vib/vib.csproj" />
    <ProjectReference Include="../../src/Vibranium.Analyzer/Vibranium.Analyzer.csproj" />
    <Compile Remove="results/**;corpus/**" />
    <None Remove="results/**;corpus/**" />
  </ItemGroup>
</Project>
